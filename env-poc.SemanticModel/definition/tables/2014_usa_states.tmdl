		summarizeBy: sum
		sourceColumn: Population

		annotation SummarizationSetBy = Automatic

	partition 2014_usa_states = m
		mode: import
		source =
				let
				    BaseUrl = "https://raw.githubusercontent.com/iam-kanavsharma/datasets/",
				    // Lookup table for environment → URL
				    EnvMap = [
				        dev = "refs/heads/dev/2014_usa_states.csv",
				        qa  = "refs/heads/qa/2014_usa_states.csv",
				        prod = "refs/heads/prod/2014_usa_states.csv"
				    ],
				
				    // Get URL based on selected environment
				    SelectedPath = Record.Field(EnvMap, pEnvironment),
				
				    // Load CSV from selected URL
				    Source = Csv.Document(Web.Contents(BaseUrl & SelectedPath), [Delimiter=",", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    PromoteHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Use First Row as Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Change Type" = Table.TransformColumnTypes(#"Use First Row as Headers",{{"Rank", Int64.Type}, {"State", type text}, {"Postal", type text}, {"Population", Int64.Type}})
				in
				    #"Change Type"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

