table 2014_usa_states
	lineageTag: 23e378b3-521b-4101-96e4-8c8738046779

	column Rank
		dataType: int64
		formatString: 0
		lineageTag: fd7ecf04-2808-4805-9997-d453215fd0e4
		summarizeBy: sum
		sourceColumn: Rank

		annotation SummarizationSetBy = Automatic

	column State
		dataType: string
		lineageTag: 9e887e4a-87d2-4b8c-a266-8a41863efcb1
		summarizeBy: none
		sourceColumn: State

		annotation SummarizationSetBy = Automatic

	column Postal
		dataType: string
		lineageTag: af576dd3-6a7b-422c-9c42-ddf0758910c7
		summarizeBy: none
